          "rawQueryText": "SELECT pp.project_name || ' ▸ ' || ps.stage_name AS metric, COALESCE(SUM(dp.quantity_produced), 0) AS value FROM production_stages ps JOIN production_projects pp ON pp.id = ps.project_id LEFT JOIN daily_production dp ON dp.stage_id = ps.id AND dp.project_id = pp.id WHERE (pp.project_name = '$project' OR '$project' = 'All') GROUP BY ps.id, pp.project_name, ps.stage_name, ps.sequence_order ORDER BY pp.project_name, ps.sequence_order",
