          "rawQueryText": "SELECT COALESCE(SUM(CASE WHEN dp.quantity_produced > 0 THEN dp.quantity_produced ELSE 0 END), 0) AS value FROM production_projects pp LEFT JOIN daily_production dp ON dp.project_id = pp.id WHERE (pp.project_name = '$project' OR '$project' = 'All')",
          "refId": "A"
        }
      ],
      "title": "Units Added",
