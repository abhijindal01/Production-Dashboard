      "targets": [
        {
          "queryType": "table",
          "rawQueryText": "SELECT\n  ps.stage_name AS metric,\n  COALESCE(SUM(dp.quantity_produced), 0) AS value\nFROM production_stages ps\nJOIN production_projects pp ON pp.id = ps.project_id\nLEFT JOIN daily_production dp\n  ON dp.stage_id = ps.id\n AND dp.project_id = pp.id\nWHERE (pp.project_name = '$project' OR '$project' = 'All')\nGROUP BY ps.id, ps.stage_name, ps.sequence_order\nORDER BY pp.project_name, ps.sequence_order",
          "refId": "A"
        }
      ],
      "title": "Output by Stage (includes zero quantity stages)",
      "type": "bargauge"
