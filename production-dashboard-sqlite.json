      "targets": [
        {
          "queryType": "table",
          "rawQueryText": "SELECT\n  ps.stage_name AS Stage,\n  COALESCE(SUM(qt.quantity_tested), 0) AS Tested,\n  COALESCE(SUM(qt.quantity_passed), 0) AS Passed,\n  COALESCE(SUM(qt.quantity_failed), 0) AS Failed\nFROM production_stages ps\nJOIN production_projects pp ON pp.id = ps.project_id\nLEFT JOIN quality_tests qt\n  ON qt.stage_id = ps.id\n AND qt.project_id = pp.id\nWHERE (pp.project_name = '$project' OR '$project' = 'All')\nGROUP BY ps.id, ps.stage_name, ps.sequence_order\nORDER BY pp.project_name, ps.sequence_order",
          "refId": "A"
        }
      ],
      "title": "Quality: Pass vs Fail by Stage (includes zero stages)",
      "type": "table"
