          "rawQueryText": "SELECT COALESCE(SUM(dp.quantity_produced), 0) AS value FROM production_projects pp LEFT JOIN daily_production dp ON dp.project_id = pp.id WHERE (pp.project_name = '$project' OR '$project' = 'All')",
