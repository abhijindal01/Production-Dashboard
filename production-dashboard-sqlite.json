      "targets": [
        {
          "queryType": "table",
          "rawQueryText": "SELECT pp.project_name || ' ▸ ' || ps.stage_name AS Stage, COALESCE(SUM(qt.quantity_tested), 0) AS Tested, COALESCE(SUM(qt.quantity_passed), 0) AS Passed, COALESCE(SUM(qt.quantity_failed), 0) AS Failed, COALESCE(ROUND(SUM(qt.quantity_passed) * 100.0 / NULLIF(SUM(qt.quantity_tested), 0), 1), 0) AS \"Pass %\" FROM production_stages ps JOIN production_projects pp ON pp.id = ps.project_id LEFT JOIN quality_tests qt ON qt.stage_id = ps.id AND qt.project_id = pp.id WHERE (pp.project_name = '$project' OR '$project' = 'All') GROUP BY ps.id, pp.project_name, ps.stage_name, ps.sequence_order ORDER BY pp.project_name, ps.sequence_order",
          "refId": "A"
