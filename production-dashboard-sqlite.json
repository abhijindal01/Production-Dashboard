          "rawQueryText": "SELECT\n  dp.production_date AS time,\n  ps.stage_name AS metric,\n  SUM(dp.quantity_produced) AS value\nFROM daily_production dp\nJOIN production_stages ps ON ps.id = dp.stage_id\nJOIN production_projects pp ON pp.id = dp.project_id\nWHERE (pp.project_name = '$project' OR '$project' = 'All')\n  AND dp.production_date >= date('now', '-30 days')\nGROUP BY dp.production_date, ps.id, ps.stage_name\nORDER BY dp.production_date, ps.sequence_order",
          "refId": "A",
