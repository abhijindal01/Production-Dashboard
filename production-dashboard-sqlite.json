          "rawQueryText": "SELECT\n  rl.rework_date AS time,\n  ps.stage_name AS metric,\n  SUM(rl.quantity_reworked) AS value\nFROM rework_log rl\nJOIN production_stages ps ON ps.id = rl.stage_id\nJOIN production_projects pp ON pp.id = rl.project_id\nWHERE (pp.project_name = '$project' OR '$project' = 'All')\n  AND rl.rework_date >= date('now', '-30 days')\nGROUP BY rl.rework_date, ps.id, ps.stage_name\nORDER BY rl.rework_date, ps.sequence_order",
